# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# In AI Studio / Cloud Run, this is automatically injected or derived from request headers.
APP_URL="MY_APP_URL"

# Storage location for uploaded files and temporary chunks
STORAGE_PATH="./data/storage"

# Maximum upload size (e.g., 10GB, 500MB). Evaluated by backend and client.
MAX_FILE_SIZE="10GB"

# Chunk size for streaming uploads (e.g., 5MB)
CHUNK_SIZE="5MB"

# Secret used for hashing passwords and session verification
SESSION_SECRET="air-loom-secure-secret-key"

